Package quinas;

/* Grupo 14 
	ENZO LIBÓRIO FRAGA
	JOÃO VICTOR CARVALHO SIMÕES
	JOÃO CARLOS CRUZ SANTOS
	MAXWELL ALEXANDRE SOUZA
*/

Helpers
    /* Caracteres Básicos */
    digito = ['0' .. '9'];
    digito_bin = ['0' + '1'];
    letra_minuscula = ['a' .. 'z'];
    letra_maiuscula = ['A' .. 'Z'];
    letra = letra_minuscula | letra_maiuscula;
    
    /* Quebras de linha e brancos */
    cr = 13;
    lf = 10;
    tab = 9;
    espaco = ' ';
    fim_de_linha = cr | lf | (cr lf);
    espacos = (espaco | tab | fim_de_linha)+;

    /* Auxiliares para Comentários de Bloco no estilo C (não aninhados) */
    qualquer_caractere = [0 .. 0xffff];
    nao_traco = [qualquer_caractere - '-'];
    nao_barra_traco = [qualquer_caractere - ('/' + '-')];

Tokens
    /* Palavras Reservadas e Tipos Primitivos */
    numero = 'numero';
    booleano = 'booleano';

    /* Valores Booleanos */
    val_verdadeiro = 'V';
    val_falso = 'F';

    /* Marcador de Entrada */
    ponto_entrada = '++';

    /* Delimitadores e Pontuação */
    colchete_esq = '[';
    colchete_dir = ']';
    dois_pontos = ':';
    pipe = '|';
    igual = '=';
    cerquilha = '#';
    parentese_esq = '<';
    parentese_dir = '>';

    /* Operadores Aritméticos */
    mais = '+';
    menos = '-';
    ponto = '.';
    barra = '/';
    resto = '\\';
    div_inteira = '//';
    potencia = '`';

    /* Operadores Relacionais */
    maior_que = '>>';
    menor_que = '<<';
    igualdade = '==';

    /* Operadores Booleanos */
    e_logico = '^';
    nao_logico = '¬';
    ou_logico = 'v';
    guarda_pipe = '||';

    /* Identificadores e Numerais */
    ID_CONST = letra_maiuscula letra_maiuscula+;
    ID_FUNCAO = letra_maiuscula letra+;
    ID = letra_minuscula letra_minuscula+;

    numeral_int = (digito+) | ('0b' digito_bin+);
    numeral_real = (digito+) ',' (digito+);

    /* Ignorados (Brancos e Comentários) */
    brancos = espacos;
    comentario_linha = '--' [qualquer_caractere - [cr + lf]]* fim_de_linha?;
    comentario_bloco = '/--' nao_traco* '-' (nao_barra_traco nao_traco* '-' | '-')* '/';

Ignored Tokens
    brancos,
    comentario_linha,
    comentario_bloco;

Productions
    programa = dec_funcao+;

    dec_funcao = ponto_entrada? colchete_esq tipo ID_FUNCAO colchete_esq lista_parametros colchete_dir dois_pontos colchete_esq exp colchete_dir colchete_dir;

    tipo = numero | booleano;

    lista_parametros = 
        {vazio} 
      | {com_parametro} parametro (pipe parametro)*;

    parametro = 
        {primitivo} tipo ID 
      | {assinatura} assinatura;

    assinatura = tipo ID_FUNCAO colchete_esq parametros_assinatura colchete_dir;

    /* Os parâmetros na assinatura de uma função passada como parâmetro não têm IDentificador */
    parametros_assinatura = 
        {vazio} 
      | {com_parametro} parametro_assinatura (pipe parametro_assinatura)*;

    parametro_assinatura = 
        {tipo} tipo 
      | {assinatura} assinatura;

    exp = 
        {int} numeral_int
      | {real} numeral_real
      | {verdadeiro} val_verdadeiro
      | {falso} val_falso
      | {ID} ID
      | {const} ID_CONST
      | {bloco} bloco_exp
      | {chamada} chamada
      | {guarda} guarda
      | {parenteses} parentese_esq exp parentese_dir
      | {negativo} menos exp
      | {potencia} exp potencia exp
      | {soma} exp mais exp
      | {subtracao} exp menos exp
      | {multiplicacao} exp ponto exp
      | {divisao} exp barra exp
      | {div_inteira} exp div_inteira exp
      | {resto} exp resto exp
      | {igualdade} exp igualdade exp
      | {menor} exp menor_que exp
      | {maior} exp maior_que exp
      | {nao} nao_logico exp
      | {e} exp e_logico exp
      | {ou} exp ou_logico exp;

    guarda = colchete_esq (guarda_pipe exp igual exp)+ guarda_pipe cerquilha igual exp colchete_dir;

    bloco_exp = colchete_esq dec_cons+ exp colchete_dir;

    dec_cons = colchete_esq tipo ID_CONST colchete_esq exp colchete_dir colchete_dir;

    chamada = ID_FUNCAO colchete_esq lista_args colchete_dir;

    lista_args = 
        {vazio} 
      | {com_args} arg (pipe arg)*;

    arg = 
        {exp} exp
      | {funcao} ID_FUNCAO;